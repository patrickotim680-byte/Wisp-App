# ── Vercel project environment variables ─────────────────────────────────────
# Exposed to the browser through /api/config. Safe: anon key only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Optional TURN relay. Without it, calls only connect on networks where STUN
# is enough (most home networks, not most corporate/CGNAT ones).
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=wisp
TURN_CREDENTIAL=replace-me

# Optional Web Push public key, if you wire a push provider (see README).
VAPID_PUBLIC_KEY=

# ── Supabase Edge Function secrets (set with `supabase secrets set`) ────────
# Never put these in Vercel; they are server-side only.
# SERVICE_ROLE_KEY=...            # used by push-notify to read device tokens
# FCM_PROJECT_ID=...              # Firebase project id for FCM HTTP v1
# FCM_CLIENT_EMAIL=...            # service-account email
# FCM_PRIVATE_KEY=...             # service-account private key (PEM, \n escaped)

# ── Google Maps browser key — optional, for shared locations ────────────────
# With it, a location in a chat renders as a real Google Static Maps raster with
# a marker and a reverse-geocoded address line. Without it the same card is
# drawn from OpenStreetMap tiles and shows coordinates instead of an address:
# the feature works either way, it just looks less like the Maps app.
#
# Enable "Maps Static API" and "Geocoding API" on the key, and restrict it by
# HTTP referrer to your Vercel domain. It reaches the browser through
# /api/config by design, so this must be a restricted browser key — never a
# server-side one, and never the same key you use anywhere unrestricted.
GOOGLE_MAPS_KEY=
